# Personal data and runtime state: never commit
profile/
workspace/*
!workspace/.gitkeep
.env
.env.local
.insforge/
*.pdf

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# web app
apps/web/node_modules/
apps/web/.next/
apps/web/tsconfig.tsbuildinfo
workspace/.pages/

# public feed: built by `python -m engine site`, published to the gh-pages branch
site/

# coverage output
.coverage
coverage.xml
htmlcov/
